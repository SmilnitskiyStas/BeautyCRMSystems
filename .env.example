# Секрети лише тут (локально .env, не комітити)
# Runtime-рядок API: ЛИШЕ роль NOSUPERUSER NOBYPASSRLS без прав DDL (інакше RLS не діє). API при старті перевіряє pg_roles
# (rolsuper / rolbypassrls) і падає, якщо роль привілейована. Роль створює DBA/міграція (GRANT SELECT,INSERT,UPDATE,DELETE на таблиці).
ConnectionStrings__Default=Host=localhost;Database=beautycrm;Username=beautycrm_app;Password=changeme-app
# Рядок для міграцій (dotnet ef database update): роль-власник схеми; в runtime API не використовується.
ConnectionStrings__Migrator=Host=localhost;Database=beautycrm;Username=beautycrm_owner;Password=changeme-owner
# Лише локальна розробка (Development): дозволити superuser/BYPASSRLS-роль у runtime (з попередженням). Поза Development ігнорується.
Beauty__AllowPrivilegedDbRole=false
# Не використовуйте PgBouncer у режимі transaction pooling і Npgsql Multiplexing: app.tenant_id тримається на з'єднанні
# (потрібен session pooling або прямі з'єднання).
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Ключ шифрування секретів каналів: base64 від 32 байт (openssl rand -base64 32)
Channels__EncryptionKey=
# X-Tenant-Id працює ЛИШЕ в середовищі Development (і лише без токена; захищені ендпоінти все одно вимагають JWT).
# Поза Development ігнорується незалежно від цього значення; tenant береться з claim tenant_id.
Beauty__AllowTenantHeader=false
# Автентифікація (TASK-684). Без Auth__JwtSigningKey API не стартує.
# Ключ підпису JWT: base64 від >=32 байт (openssl rand -base64 48)
Auth__JwtSigningKey=
# Ключ оператора платформи для POST /api/platform/tenants (заголовок X-Platform-Key), >=32 символи
# (openssl rand -base64 36). Порожній/короткий = ендпоінти оператора вимкнені.
Auth__PlatformKey=
# Необов'язково (значення за замовчуванням у дужках): Auth__Issuer (beautycrm), Auth__Audience (beautycrm-api),
# Auth__MaxFailedAttempts (5), Auth__LockoutMinutes (15), Auth__AccessTokenMinutes (15), Auth__RefreshTokenDays (14),
# Auth__InviteDays (7), Auth__MinPasswordLength (12), Auth__BcryptWorkFactor (12),
# Auth__RateLimit__PermitLimit (10) / Auth__RateLimit__WindowSeconds (60) на IP для login/refresh/accept/platform
# Mock-адаптери каналів: ЛИШЕ Development (поза Development true = помилка старту). За замовчуванням false.
Channels__UseMocks=false
# Довірені reverse proxy (IP або CIDR, через кому): лише від них береться X-Forwarded-For/Proto (ключ rate limit = справжній IP).
# Порожньо = X-Forwarded-* ігноруються.
Beauty__TrustedProxies=
# Origin адмінки для CORS (точні, через кому, без "*"): https://admin.example.com. Порожньо = CORS вимкнено. Credentials не потрібні.
Beauty__AllowedOrigins=
# Instagram/Messenger: appSecret (HMAC підпису) і verifyToken (GET handshake) задаються в налаштуваннях каналу
# (PUT /api/beauty/channels/{id}: appSecret, verifyToken) і зберігаються зашифрованими; це РІЗНІ значення.
# Додатково (за замовчуванням): Auth__RateLimit__RefreshPermitLimit (120/хв на IP), Auth__RateLimit__RefreshPerTokenPermit (5),
# Auth__RateLimit__RefreshPerTenantPermit (600).
