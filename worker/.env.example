# Email-канал воркера (підтвердження запису та нагадування на пошту клієнта).
# mock (за замовчуванням): лист НЕ відправляється, у лог пишеться лише факт ("email queued (mock, not sent)") без адреси й тексту.
EMAIL_MODE=mock
# Для EMAIL_MODE=smtp усі змінні нижче обов'язкові (інакше воркер не стартує). Секрети лише в .env, не комітити.
SMTP_HOST=
SMTP_PORT=587
# true для неявного TLS (порт 465), false для STARTTLS (587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Beauty CRM <no-reply@example.com>"

# Скидання пароля (TASK-865): базова адреса застосунку для посилання {PUBLIC_APP_URL}/reset-password#t=<токен>. https (http лише в Development/loopback).
PUBLIC_APP_URL=http://localhost:3000
# Лише Development + EMAIL_MODE=mock: папка, куди складаються .txt-листи (містять токен!) для ручної перевірки. За замовчуванням не пишеться.
# WORKER_MOCK_MAIL_DIR=
