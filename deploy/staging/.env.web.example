# web (Next.js) -> $SECRETS_DIR/web.env. Усе нижче НЕ секрети, але реальні значення не комітити.
# Універсальні посилання закладів: /l/{code} і /.well-known/* (див. .claude/docs/runbook.md, реліз-крок "Universal links").

# --- Runtime (читаються при кожному запиті; зміна = restart web) ---
# Apple Team ID (10 символів, Apple Developer -> Membership). Порожньо = /.well-known/apple-app-site-association -> 404
APPLE_TEAM_ID=
# Bundle ID iOS-застосунку (збігається з mobile/app.config.ts)
IOS_BUNDLE_ID=com.beautycrm.booking
# Android applicationId (збігається з mobile/app.config.ts). Порожньо = assetlinks.json -> 404
ANDROID_PACKAGE=
# SHA-256 сертифіката підпису (формат AA:BB:..., кілька через кому: upload + Play App Signing). Порожньо = 404
ANDROID_SHA256_CERT_FINGERPRINTS=
# Server-side URL API для сторінки /l/[code] (resolve коду). Fallback: NEXT_PUBLIC_API_URL
API_INTERNAL_URL=http://api:8080

# --- Build-time (передаються build-arg при збірці образу, у runtime-файлі не діють) ---
# Посилання на магазини для кнопок лендінгу /l/{code}
NEXT_PUBLIC_IOS_STORE_URL=
NEXT_PUBLIC_ANDROID_STORE_URL=
