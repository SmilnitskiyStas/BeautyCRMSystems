# Змінні для `docker compose --env-file` (не секрети, але специфічні для сервера). Копія на сервері: .env.compose (у .gitignore).
# Каталог з env-файлами сервісів (db.env, api.env, worker.env), поза клоном репозиторію, режим 600.
SECRETS_DIR=/opt/beauty_staging/secrets
# Порти ЛИШЕ на 127.0.0.1 хоста. Перед запуском перевірте, що вони вільні: ss -ltn (див. README).
BEAUTY_API_PORT=5200
BEAUTY_WEB_PORT=3400
# Вільна підмережа для мережі beauty_staging і її шлюз (перша адреса). Шлюз = Beauty__TrustedProxies в api.env.
BEAUTY_SUBNET=172.29.200.0/24
BEAUTY_GATEWAY=172.29.200.1
# Образи за digest (вивід staging-images.yml): ghcr.io/OWNER/beautycrm-SERVICE@sha256:<64 hex>
API_IMAGE=REPLACE_WITH_IMAGE_REF
WORKER_IMAGE=REPLACE_WITH_IMAGE_REF
WEB_IMAGE=REPLACE_WITH_IMAGE_REF
