# api.env (контейнер api). Режим 600. Тут НЕМАЄ пароля beautycrm_owner і Migrator-рядка.
ASPNETCORE_ENVIRONMENT=Staging
# Роль beautycrm_app (NOSUPERUSER NOBYPASSRLS). Пароль = DB_APP_PASSWORD з db.env.
ConnectionStrings__Default=Host=db;Port=5432;Database=beautycrm;Username=beautycrm_app;Password=REPLACE_ME
Auth__JwtSigningKey=REPLACE_ME
# Ключ оператора для /api/platform/tenants (у Caddy закритий, див. PLATFORM_ALLOWED_CIDR).
Auth__PlatformKey=REPLACE_ME
# ADR-018: X-Platform-Key працює поза Development лише при true (за замовчуванням вимкнено). Вмикати на час ручного provisioning (create-tenant.sh).
Auth__PlatformKeyEnabled=false
# ADR-018: ключі ControlPlaneHmac для /api/control/v1/* (секрет - base64 від >= 32 байт; kid - [a-z0-9-]{3,32}; Status = active | retiring).
# Без жодного валідного active-ключа група вимкнена. Значення задає лише оператор сервера; у репозиторії - порожні плейсхолдери.
ControlPlane__Inbound__Keys__REPLACE-KID__Secret=
ControlPlane__Inbound__Keys__REPLACE-KID__Status=
# ADR-018: публічна адреса застосунку для посилань-запрошень власника ({PublicAppUrl}/invite#t=...); без неї create/owner-invite не працюють.
ControlPlane__PublicAppUrl=
# ADR-018: строк дії запрошення власника, годин (за замовчуванням 72).
ControlPlane__InviteTtlHours=72
Channels__EncryptionKey=REPLACE_ME
# Майстер-ключ ШІ (ADR-021): id і значення; бекап ключа окремо від БД. Ім'я змінної містить id ключа.
Ai__Secrets__ActiveKeyId=k1
Ai__Secrets__Keys__k1=REPLACE_ME
# Шлюз мережі beauty_staging (= BEAUTY_GATEWAY): саме з цієї адреси контейнер бачить запити від nginx хоста через loopback-порт.
Beauty__TrustedProxies=172.29.200.1
# Точний origin web (https, без слеша в кінці, без "*").
Beauty__AllowedOrigins=https://beauty.example.com
Beauty__AllowTenantHeader=false
Beauty__AllowPrivilegedDbRole=false
# Прапорці staging (ADR-016 §2.10).
Channels__UseMocks=false
Ai__UseMockProvider=false
# Telegram polling на staging заборонений кодом (лише Development); транспорт Telegram - відкрите рішення людини (ADR-016 Q1).
Channels__Telegram__Polling__Enabled=false
ChatPhone__Enabled=false
Marketing__Enabled=false
# Вмикати лише для тестового бота й синтетичного tenant після рішення Q1 та юридичного gate:
ChatAssistant__Enabled=false
ChatButtons__Enabled=false

# Публічний запис / мобільний застосунок (ADR-022, runbook §3). У env-файлі контейнера ключі пишуться через "__".
# Режими захисту клієнтів: none | monitor | enforce. Найслабший прийнятий шлях визначає захист усього публічного API,
# тому Web/Ios/Android мають збігатися (інакше у Production старт падає, у Staging/Development лише попередження),
# або свідомо PublicBooking__AllowWeakerClientPaths=true (рішення людини, ADR-022 відкрите питання 4).
# Атестація App Attest / Play Integrity ще не підключена: enforce для Ios/Android без неї блокуватиме всіх, тож поки none або monitor.
PublicBooking__Protection__Web=none
PublicBooking__Protection__Ios=none
PublicBooking__Protection__Android=none
PublicBooking__AllowWeakerClientPaths=false
# Ліміт публічних записів на заклад за годину (за замовчуванням 60; 0 = вимкнено)
PublicBooking__MaxPublicCreatesPerLocationPerHour=60
# Rate limit публічних ендпоїнтів на IP за вікно (за замовчуванням: Read 120, Token 30, Write 10, Nearby 10, Search 20; вікно 60 с)
PublicBooking__RateLimit__WindowSeconds=60
PublicBooking__RateLimit__WritePermit=10
PublicBooking__RateLimit__NearbyPermit=10
PublicBooking__RateLimit__SearchPermit=20
# Мінімальна версія застосунку (нижче -> 426 upgrade_required); порожньо = без обмеження
PublicBooking__MinAppVersion__Ios=
PublicBooking__MinAppVersion__Android=
# Необов'язково: окремий ключ токенів запису (base64 від >= 32 байт). Порожньо = похідний від Auth__JwtSigningKey. Значення задає лише людина.
PublicBooking__TokenKey=
# ВАЖЛИВО для rate limit: без правильного Beauty__TrustedProxies (вище) усі клієнти бачаться з IP проксі і лімітуються разом.
