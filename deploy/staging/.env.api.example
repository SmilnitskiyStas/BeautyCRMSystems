# api.env (контейнер api). Режим 600. Тут НЕМАЄ пароля beautycrm_owner і Migrator-рядка.
ASPNETCORE_ENVIRONMENT=Staging
# Роль beautycrm_app (NOSUPERUSER NOBYPASSRLS). Пароль = DB_APP_PASSWORD з db.env.
ConnectionStrings__Default=Host=db;Port=5432;Database=beautycrm;Username=beautycrm_app;Password=REPLACE_ME
Auth__JwtSigningKey=REPLACE_ME
# Ключ оператора для /api/platform/tenants (у Caddy закритий, див. PLATFORM_ALLOWED_CIDR).
Auth__PlatformKey=REPLACE_ME
Channels__EncryptionKey=REPLACE_ME
# Майстер-ключ ШІ (ADR-010): id і значення; бекап ключа окремо від БД. Ім'я змінної містить id ключа.
Ai__Secrets__ActiveKeyId=k1
Ai__Secrets__Keys__k1=REPLACE_ME
# Шлюз мережі beauty_staging (= BEAUTY_GATEWAY): саме з цієї адреси контейнер бачить запити від nginx хоста через loopback-порт.
Beauty__TrustedProxies=172.29.200.1
# Точний origin web (https, без слеша в кінці, без "*").
Beauty__AllowedOrigins=https://beauty.example.com
Beauty__AllowTenantHeader=false
Beauty__AllowPrivilegedDbRole=false
# Прапорці staging (ADR-016 §2.10).
Channels__UseMocks=false
Ai__UseMockProvider=false
# Telegram polling на staging заборонений кодом (лише Development); транспорт Telegram - відкрите рішення людини (ADR-016 Q1).
Channels__Telegram__Polling__Enabled=false
ChatPhone__Enabled=false
Marketing__Enabled=false
# Вмикати лише для тестового бота й синтетичного tenant після рішення Q1 та юридичного gate:
ChatAssistant__Enabled=false
ChatButtons__Enabled=false
