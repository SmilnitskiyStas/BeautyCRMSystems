# worker.env (контейнер worker). Режим 600. Роль beautycrm_worker (НЕ app).
ASPNETCORE_ENVIRONMENT=Staging
NODE_ENV=production
WORKER_DATABASE_URL=postgres://beautycrm_worker:REPLACE_ME@db:5432/beautycrm
# Id синтетичних tenant через кому (з'являються після створення tenant).
WORKER_TENANT_IDS=
# Той самий ключ, що в api.env (розшифровка токенів каналів).
Channels__EncryptionKey=REPLACE_ME
Channels__UseMocks=false
# Усе вимкнено до окремого рішення (ADR-016 §2.10; маркетинг: legal gate §26.16).
WORKER_REMINDERS_ENABLED=false
WORKER_REVIEWS_ENABLED=false
WORKER_REMINDER_BUTTONS_ENABLED=false
WORKER_CAMPAIGNS_ENABLED=false
WORKER_WINBACK_ENABLED=false
