# worker.env (контейнер worker). Режим 600. Роль beautycrm_worker (НЕ app).
ASPNETCORE_ENVIRONMENT=Staging
NODE_ENV=production
WORKER_DATABASE_URL=postgres://beautycrm_worker:REPLACE_ME@db:5432/beautycrm
# Id синтетичних tenant через кому (з'являються після створення tenant).
WORKER_TENANT_IDS=
# Той самий ключ, що в api.env (розшифровка токенів каналів).
Channels__EncryptionKey=REPLACE_ME
Channels__UseMocks=false
# Усе вимкнено до окремого рішення (ADR-016 §2.10; маркетинг: legal gate §26.16).
WORKER_REMINDERS_ENABLED=false
WORKER_REVIEWS_ENABLED=false
WORKER_REMINDER_BUTTONS_ENABLED=false
WORKER_CAMPAIGNS_ENABLED=false
WORKER_WINBACK_ENABLED=false
# Склад: сповіщення персоналу (low_stock/expiring), раз на годину; також потрібен модуль beauty_inventory у tenant (§32.20).
WORKER_INVENTORY_ENABLED=false
# WORKER_INVENTORY_EXPIRY_DAYS=30,14,7
# WORKER_INVENTORY_LOCAL_HOUR=8
# Склад: Telegram-сповіщення власнику (§32.24, етап 2b). Лише літерал true вмикає побудову й відправку (прибирання працює завжди); поза dev - після L3.
WORKER_INVENTORY_TELEGRAM_ENABLED=false
# Замовлення товарів (§33.17): раз на хвилину pending_payment -> expired для прострочених без оплати; лише літерал true; також потрібен модуль beauty_inventory.
WORKER_PRODUCT_ORDERS_ENABLED=false
# M1: поза Development воркер з ENABLED=true не стартує без ОДНОГО з двох: L3_APPROVED=true (прод, після юридичного L3)
# або pre-L3 allowlist tenant-ів (staging, UUID через кому; обробляються лише вони).
# WORKER_INVENTORY_TELEGRAM_L3_APPROVED=false
# WORKER_INVENTORY_TELEGRAM_PRE_L3_TENANT_IDS=
# Тихі години за часом закладу: [QUIET_START, QUIET_END), цілі 0-23, START != END (помилка старту інакше)
# WORKER_INVENTORY_TELEGRAM_QUIET_START=21
# WORKER_INVENTORY_TELEGRAM_QUIET_END=8
# База посилань у тексті (лише https://, без кінцевого /); порожньо = без посилання
WORKER_ADMIN_BASE_URL=
# ShelfGuard: доставка заявок (TASK-821). Вимкнено, доки не задано; значення ставить людина на сервері (не комітити).
SHELFGUARD_FEEDBACK_ENABLED=false
SHELFGUARD_BASE_URL=
SHELFGUARD_FEEDBACK_KEY_ID=
SHELFGUARD_FEEDBACK_SECRET=

# Email-канал (підтвердження запису, нагадування клієнтам мобільного застосунку без месенджера).
# EMAIL_MODE=mock (за замовчуванням, якщо змінної немає): листи НЕ надсилаються, у лог пишеться лише id і kind.
# EMAIL_MODE=smtp: усі SMTP_* і EMAIL_FROM обов'язкові, інакше worker не стартує. Секрети вписує лише людина на сервері.
# Провайдер SMTP на staging ще не обрано (відкрите рішення людини).
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
# true лише для неявного TLS (порт 465); для STARTTLS (587) лишайте false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Адреса відправника, напр. "Beauty CRM <no-reply@YOUR-DOMAIN>" (домен із SPF/DKIM)
EMAIL_FROM=

# TASK-865 (ADR-024): лист скидання пароля. Посилання будується ЛИШЕ з цієї адреси ({PUBLIC_APP_URL}/reset-password#t=...),
# ніколи із заголовків запиту. Без неї (або з http поза Development) лист не відправляється, запити чекають до спливу TTL.
# Відправник = EMAIL_FROM (задає ops). У mock-режимі лист не надсилається.
PUBLIC_APP_URL=
