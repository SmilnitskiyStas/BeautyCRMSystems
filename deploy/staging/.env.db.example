# db.env (контейнер db). Режим 600. Значення генеруються на сервері, див. README.
# Не використовувати ті самі значення, що в dev чи інших середовищах.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME
# Паролі ролей для init-roles.sh (читаються лише при ПЕРШІЙ ініціалізації тому). Hex: безпечні в URL і в SQL.
DB_OWNER_PASSWORD=REPLACE_ME
DB_APP_PASSWORD=REPLACE_ME
DB_WORKER_PASSWORD=REPLACE_ME
