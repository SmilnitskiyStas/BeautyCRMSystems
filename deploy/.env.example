# Beauty CRM: змінні production-стеку. Скопіюйте у deploy/.env (у .gitignore) і заповніть. НЕ комітьте .env.
# Пароли й ключі генеруйте на сервері (див. deploy/README.md §2). Паролі БД: лише [A-Za-z0-9] (hex), без `;` `'` `@` `:` `/` `$`
# (вони потрапляють у рядок підключення Npgsql і URL worker).

# ---- Compose ----
COMPOSE_PROJECT_NAME=beautycrm
BEAUTY_IMAGE_PREFIX=beautycrm
BEAUTY_IMAGE_TAG=local
# Підмережа docker-мережі; = діапазон довірених проксі за замовчуванням. Змініть, якщо конфліктує з наявними мережами сервера.
BEAUTY_NET_SUBNET=172.29.88.0/24
# Порти на 127.0.0.1 хоста (для хостового nginx). nginx/beauty.conf має вказувати на ті самі.
WEB_HOST_PORT=13000
API_HOST_PORT=15080
PROXY_HOST_PORT=18080

# ---- PostgreSQL ----
POSTGRES_DB=beautycrm
POSTGRES_PASSWORD=__GENERATE__          # суперкористувач кластера (лише init/адмін-операції)
BEAUTY_DB_OWNER_PASSWORD=__GENERATE__   # beautycrm_owner: власник схеми, міграції
BEAUTY_DB_APP_PASSWORD=__GENERATE__     # beautycrm_app: runtime API/worker (NOSUPERUSER NOBYPASSRLS)

# ---- API: автентифікація й шифрування (runbook §3) ----
Auth__JwtSigningKey=__GENERATE__        # openssl rand -base64 48
Auth__PlatformKey=__GENERATE__          # openssl rand -base64 36 ; ключ оператора платформи (X-Platform-Key)
Channels__EncryptionKey=__GENERATE__    # openssl rand -base64 32 ; після заміни збережені секрети каналів не розшифруються
# Поза Development true зупиняє старт API. Залишайте false.
Channels__UseMocks=false

# ---- API: хостинг ----
# Точні origin через кому, без `*`. Якщо зовнішній HTTPS-порт не 443 — додайте його: https://beauty.agrusystems.pp.ua:8443
Beauty__AllowedOrigins=https://beauty.agrusystems.pp.ua
# IP/CIDR довірених reverse proxy (через кому). Без нього X-Forwarded-For ігнорується і rate limit по IP рахує IP проксі.
# Хостовий nginx бачиться API як gateway docker-мережі, контейнерний proxy — як контейнер: обидва в BEAUTY_NET_SUBNET.
Beauty__TrustedProxies=172.29.88.0/24

# ---- API: публічний запис (ADR-011) ----
# Порожньо = ключ виводиться з Auth__JwtSigningKey. Окремий: openssl rand -base64 32
PublicBooking__TokenKey=
PublicBooking__CaptchaRequired=false
# Production падає на старті, якщо режими Protection Web/Ios/Android різні, доки не true. Тримайте однаковими.
PublicBooking__Protection__Web=none
PublicBooking__Protection__Ios=none
PublicBooking__Protection__Android=none
PublicBooking__AllowWeakerClientPaths=false
PublicBooking__MinAppVersion__Ios=
PublicBooking__MinAppVersion__Android=
PublicBooking__MaxPublicCreatesPerLocationPerHour=60
PublicBooking__RateLimit__NearbyPermit=10
PublicBooking__RateLimit__SearchPermit=20

# ---- Worker ----
# UUID tenant-ів через кому (з'являються після створення tenant; після зміни: `docker compose ... up -d worker`).
WORKER_TENANT_IDS=
WORKER_MARKETING_DAILY_LIMIT=
WORKER_DEFAULT_TIMEZONE=Europe/Kyiv
# mock | smtp. Для smtp потрібні всі SMTP_* і EMAIL_FROM (інакше worker не стартує). Провайдер SMTP не обрано.
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=

# ---- Web (NEXT_PUBLIC_* вбудовуються під час збірки образу; зміна = `up -d --build web`) ----
# Публічний origin, яким користується браузер (nginx розводить /api/ на API, /api/session/ на Next).
NEXT_PUBLIC_API_URL=https://beauty.agrusystems.pp.ua
# Slug tenant-а за замовчуванням для /book (порожньо = лише /book/{slug}).
NEXT_PUBLIC_TENANT_SLUG=
