{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@beauty/booking-core": ["../packages/booking-core/src/index.ts"],
      "zod": ["./node_modules/zod"]
